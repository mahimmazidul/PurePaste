# Copy to .dev.vars for local development. Never commit .dev.vars.
#
# Signs unlock cookies and peppers stored password verifiers. Required in production
# (wrangler secret put APP_SECRET). Any long random string works, for example:
#   openssl rand -base64 32
APP_SECRET="dev-only-secret-change-me"

# Optional: Cloudflare Turnstile, for browser-side creation checks.
# Set FEATURE_TURNSTILE="on" in wrangler.jsonc as well to display the widget.
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

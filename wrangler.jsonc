{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "purepaste",
  "main": "src/index.ts",
  // Set to today's date when you fork this project. Newer dates opt in to newer runtime behaviour.
  "compatibility_date": "2026-10-01",
  // No hostname is hard-coded anywhere in the application: URLs are built from the incoming request,
  // so the same build works on workers.dev, a custom domain, or a preview URL.
  "workers_dev": true,
  // Static assets (CSS, self-hosted fonts, client scripts) are served directly by Cloudflare without
  // invoking the Worker. Every dynamic route falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purepaste",
      // Created 2026-10-12 via: npm run db:create
      "database_id": "3c795d78-6c6c-4678-ab42-5fa284cca3f5",
      "migrations_dir": "migrations"
    }
  ],
  // Blob storage is a Backblaze B2 bucket now (see S3_* below), which is why this
  // namespace still exists: files uploaded while KV was the store are readable
  // through it until the hourly sweep has deleted them from both places. Set
  // STORAGE_FALLBACK to "off" once the namespace is empty, and drop this block
  // with it. Upstream PurePaste uses R2; activating R2 needs a payment method even
  // for free-tier usage, so this fork went KV first and B2 second.
  // KV caveats, for the record: ~60s propagation to edges, 25 MiB max value, and
  // 1k writes + 1k deletes + 100k reads per day.
  "kv_namespaces": [
    {
      "binding": "BLOBS",
      // Created with: npx wrangler kv namespace create BLOBS
      "id": "c5a11354c60e46e2aff984a8522be788"
    }
  ],
  // Hourly cleanup of expired and consumed pastes. Cloudflare cron runs in UTC.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Cloudflare-native edge rate limiting. These bindings are optional at runtime: if they are
  // removed, the application keeps working and only the rate limiting is skipped.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "UNLOCK_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // Where the bytes live. B2 is a plain S3 target: endpoint, bucket and region are
    // configuration, the key pair is secrets (see README). Nothing is pinned here on
    // purpose: the selection order (R2, then a complete S3 set, then KV) already
    // picks B2 for this deployment, and it keeps a test environment without S3 keys
    // working against KV. Pin it (STORAGE_PROVIDER = "s3") if you would rather a
    // missing key be an error than a quiet fall back — the trade is exactly that.
    "S3_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "S3_BUCKET": "purepaste",
    "S3_REGION": "us-east-005",
    "S3_PREFIX": "pp/v1",
    "STORAGE_FALLBACK": "auto",
    // Supabase is a second runtime store: writes are mirrored there and reads fall
    // back to it when D1 fails. The publishable key is safe in a var because the
    // shipped schema grants it nothing but the keep-alive function; the service key,
    // which can read rows, goes in as SUPABASE_SECRET_KEY.
    "SUPABASE_URL": "https://mptumaoctfxpvqhaytqd.supabase.co",
    // Hard ceiling for every paste. The application clamps this to 30 days even if raised here.
    "MAX_TTL_SECONDS": "2592000",
    "DEFAULT_TTL_SECONDS": "604800",
    "INLINE_TEXT_MAX_BYTES": "65536",
    "TEXT_MAX_BYTES": "10485760",
    // 50 MiB now that files live in B2: KV's 25 MiB value cap was the old ceiling.
    "FILE_MAX_BYTES": "52428800",
    "PASSWORD_ITERATIONS": "210000",
    "UNLOCK_COOKIE_TTL_SECONDS": "1800",
    "FEATURE_REDIRECT": "on",
    "FEATURE_VIEW_COUNTING": "off",
    "FEATURE_TURNSTILE": "off",
    "CLEANUP_BATCH_SIZE": "100",
    "CLEANUP_MAX_BATCHES": "5",
    // Edge-cacheable for five minutes, and only for pastes that are public,
    // unlocked and not burn-after-reading. Set to 0 to make every response no-store.
    "MEDIA_CACHE_SECONDS": "300"
  },
  "observability": {
    "enabled": true,
    // Query strings can contain secrets in poorly behaved clients; keep them out of logs.
    "redact_query_string": true
  }
}
